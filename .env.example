# PostgreSQL connection string (psycopg3 driver; plain postgresql:// also works —
# the app normalizes it)
DATABASE_URL=postgresql+psycopg://trincheiras:trincheiras@localhost:5432/trincheiras

# Database used by pytest (created automatically if missing)
TEST_DATABASE_URL=postgresql+psycopg://trincheiras:trincheiras@localhost:5432/trincheiras_test

# Token for /api/v1/admin and /api/v1/reports. Leave empty to disable those
# endpoints entirely. Use a long random string in production.
ADMIN_TOKEN=

# Server port
PORT=8080

# dev | test | prod. "test" additionally mounts POST /api/v1/test/reset.
APP_ENV=dev

# Set to http://localhost:5173 while `npm run dev` is running for HMR;
# leave empty to serve the built assets from backend/app/static/dist.
VITE_DEV_SERVER=

# Production (AWS Lambda) only; the defaults below suit local development.
# DB_POOL=false opens one connection per request (a frozen Lambda sandbox must
# not hold one open, or Aurora never pauses).
DB_POOL=true
# Seconds per connection attempt, and how long to keep retrying while the
# database wakes up (0 = fail on the first error).
DB_CONNECT_TIMEOUT=10
DB_CONNECT_RETRY_SECONDS=0
# Mounts POST /internal/ops (migrate / seed). Set only on the ops Lambda.
OPS_MODE=false
