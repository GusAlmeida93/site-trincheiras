{
  "name": "trincheiras-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "gen:api": "openapi-typescript ../backend/openapi.json -o src/api/types.gen.ts",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.4.0",
    "typescript": "~5.8.0",
    "vite": "^7.0.0"
  }
}
